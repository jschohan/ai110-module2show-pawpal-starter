classDiagram
    class Owner {
        +String name
        +List~Pet~ pets
        +add_pet(pet)
        +remove_pet(pet)
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String name
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }

    class Task {
        +String description
        +time time
        +String frequency
        +bool completed
        +String pet_name
        +date due_date
        +mark_complete()
        +mark_incomplete()
        +next_occurrence() Task
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() List~Task~
        +get_pending_tasks() List~Task~
        +mark_task_complete(task) Task
        +sort_by_time(tasks) List~Task~
        +filter_by_pet(pet_name) List~Task~
        +filter_tasks(completed, pet_name) List~Task~
        +detect_conflicts() List~String~
        +generate_daily_plan() List~Task~
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : sorts, filters, detects conflicts
    Scheduler ..> Pet : adds next recurring task
    Task ..> Task : next_occurrence creates
