classDiagram
    class Owner {
        +String name
        +List~Pet~ pets
    }

    class Pet {
        +String name
        +List~Task~ tasks
    }

    class Task {
        +String name
        +int priority
        +time time
    }

    class Scheduler {
        +List~Task~ tasks
        +generate_daily_plan() List~Task~
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" o-- "0..*" Task : schedules
