classDiagram
    class Owner {
        +String name
        +List~Pet~ pets
        +add_pet(pet)
        +remove_pet(pet)
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String name
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }

    class Task {
        +String description
        +time time
        +String frequency
        +bool completed
        +String pet_name
        +mark_complete()
        +mark_incomplete()
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() List~Task~
        +get_pending_tasks() List~Task~
        +sort_by_time(tasks) List~Task~
        +filter_by_pet(pet_name) List~Task~
        +generate_daily_plan() List~Task~
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : organizes
